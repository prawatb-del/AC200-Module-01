{
  "entities": {
    "ExcelMasterResult": {
      "title": "Excel Master Result",
      "description": "User completion data for the Excel Master game",
      "type": "object",
      "properties": {
        "playerName": { "type": "string" },
        "email": { "type": "string" },
        "score": { "type": "number" },
        "completedLevels": { "type": "number" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "score", "userId"]
    },
    "AccessCode": {
      "title": "Access Code",
      "description": "Verification codes for user login",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "code": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "used": { "type": "boolean" }
      },
      "required": ["email", "code"]
    }
  },
  "firestore": {
    "/excel_master_results/{resultId}": {
      "schema": "ExcelMasterResult",
      "description": "Collection of game results"
    },
    "/access_codes/{codeId}": {
      "schema": "AccessCode",
      "description": "Collection of generated access codes"
    }
  }
}
