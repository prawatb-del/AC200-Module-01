rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidResult(data) {
      return data.email is string && data.email.size() <= 200 &&
             data.email.matches('^.+@(bumail\\.net|bu\\.ac\\.th)$') &&
             data.score is number &&
             data.userId == request.auth.uid &&
             data.timestamp == request.time;
    }

    match /excel_master_results/{resultId} {
      allow create: if isSignedIn() && isValidResult(incoming());
      allow read, delete: if isSignedIn(); 
    }

    match /access_codes/{codeId} {
      allow create: if isSignedIn() && 
                    incoming().email.matches('^.+@(bumail\\.net|bu\\.ac\\.th)$') &&
                    incoming().code is string && incoming().code.size() == 6;
      allow read, delete: if isSignedIn();
    }
  }
}
